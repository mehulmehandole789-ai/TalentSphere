# Required: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-generated-random-secret-at-least-32-characters
PORT=4000
# Optional absolute SQLite filename. Defaults to backend/data.db. Parent folder must exist.
# DATABASE_PATH=C:/path/to/talentsphere/data.db
# Optional comma-separated frontend origins, only for separate frontend hosting.
# CORS_ORIGIN=http://localhost:5173
# No MongoDB is required. Mail and payments remain explicitly unavailable until configured.
# Optional API base sent to the browser through /config.js. Default: /api
# PUBLIC_API_BASE=https://api.example.com/api

# Email verification and password recovery. Supply your SMTP provider settings.
# Without SMTP, accounts are saved but cannot finish email verification.
EMAIL_DELIVERY_MODE=smtp
# Optional separate HMAC secret (32+ random characters); otherwise JWT_SECRET is used.
# EMAIL_VERIFICATION_SECRET=
REQUIRE_ARTIST_APPROVAL=false
# Optional route/status-only authentication diagnostics; never logs bodies, codes or tokens.
AUTH_AUDIT_LOG=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-provider-login
# SMTP_PASS=your-provider-app-password
# SMTP_FROM=TalentSphere <no-reply@your-domain.com>
# APP_URL=http://localhost:4000

# Optional one-time admin bootstrap. Remove the password after running create-admin.
# ADMIN_EMAIL=your-admin-email
# ADMIN_PASSWORD=your-unique-password-at-least-12-characters
# ADMIN_NAME=Administrator
# Razorpay (optional until configured). Start in Test Mode; never put secrets in frontend files.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Standard Checkout owns desktop UPI QR and mobile app flows, subject to account/mode support.
# No dedicated QR Code API is enabled or simulated in this app.

# LOCAL DEVELOPMENT ONLY: to write verification emails to backend/.mail-preview/ instead of sending.
# Set BOTH values in your environment; preview is rejected in production.
# NODE_ENV=development
# EMAIL_DELIVERY_MODE=preview
